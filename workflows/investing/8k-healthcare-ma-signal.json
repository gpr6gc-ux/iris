    },
    {
      "name": "EDGAR Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        96
      ],
      "parameters": {
        "method": "GET",
        "url": "https://efts.sec.gov/LATEST/search-index?q=healthcare%20acquisition&forms=8-K",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "IRIS Research greyson@mccourtai.com"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "name": "Parse Hits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const r=$input.first().json;const hits=(r.hits&&r.hits.hits)||[];const rows=hits.slice(0,50).map(function(h){const s=h._source||{};const accn=s.adsh||'';const cik=(s.ciks&&s.ciks[0])||'';const cikNum=String(cik).replace(/^0+/,'');const accnNoDash=String(accn).replace(/-/g,'');const url=(cikNum&&accnNoDash)?('https://www.sec.gov/Archives/edgar/data/'+cikNum+'/'+accnNoDash+'/'):'';const nm=(s.display_names&&s.display_names[0])||'';return {accession:accn,filed_date:s.file_date||null,company:nm,cik:String(cik),form:s.form||(s.root_forms&&s.root_forms[0])||'8-K',title:nm,url:url,snippet:(s.file_description||'')};}).filter(function(x){return x.accession;});return [{json:{rows:rows,count:rows.length}}];"
      }
    },
    {
      "name": "Upsert Signals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        96
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ssuikijiaulfhfxzwrgu.supabase.co/rest/v1/rpc/iris_mna_upsert",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "<<REDACTED>>"
            },
            {
              "name": "Authorization",
              "value": "Bearer <<REDACTED>>"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({p_token:\"<<IRIS_TOKEN>>\",p_rows:$json.rows}) }}",
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "name": "Daily EDGAR sweep",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        192
